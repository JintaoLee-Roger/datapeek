# Node dependencies and generated extension bundles
node_modules/
/dist/
*.tsbuildinfo
*.vsix
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python environments, caches and packaging output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/build/

# Test coverage
coverage/
.coverage
.coverage.*
htmlcov/

# Machine-specific environment files (keep shareable templates)
.env
.env.*
!.env.example
!.env.template
.python-version

# Keep shared F5 launch/tasks configs; ignore local editor settings
.vscode/settings.json
.vscode/*.local.json
.idea/

# Generated demo data and local example interpreter configuration
/examples/*.npy
/examples/*.csv
/examples/.vscode/

# OS/editor temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
