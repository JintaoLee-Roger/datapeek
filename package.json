{
  "name": "datapeek",
  "displayName": "DataPeek",
  "description": "An extensible Python-powered scientific data viewer for VS Code.",
  "version": "0.0.1",
  "publisher": "datapeek-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DataPeek executes Python and workspace renderer code."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "datapeek.preview",
        "title": "Preview with DataPeek",
        "category": "DataPeek"
      },
      {
        "command": "datapeek.selectPython",
        "title": "Select Python Interpreter",
        "category": "DataPeek"
      },
      {
        "command": "datapeek.refreshRenderers",
        "title": "Refresh Renderers",
        "category": "DataPeek"
      },
      {
        "command": "datapeek.clearCache",
        "title": "Clear Preview Cache",
        "category": "DataPeek"
      },
      {
        "command": "datapeek.toggleAutoPreview",
        "title": "Toggle Automatic Preview",
        "category": "DataPeek"
      },
      {
        "command": "datapeek.chooseReader",
        "title": "Choose Reader",
        "category": "DataPeek"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "datapeek.preview",
          "when": "resourcePath not in datapeek.excludedPaths",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "datapeek.preview",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "DataPeek",
      "properties": {
        "datapeek.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python executable path on the extension host. Supports ${workspaceFolder}. Empty: selected Python environment, .venv, then PATH."
        },
        "datapeek.backend": {
          "type": "string",
          "enum": [
            "matplotlib",
            "plotly"
          ],
          "default": "matplotlib",
          "scope": "resource",
          "description": "Backend for the built-in NumPy renderer.",
          "deprecationMessage": "Array quick previews use lightweight Canvas. Use Detailed View for Plotly interaction."
        },
        "datapeek.rendererOptions": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "JSON options indexed by renderer ID."
        },
        "datapeek.renderTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 3600,
          "scope": "resource"
        },
        "datapeek.discoveryTimeoutSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 300,
          "scope": "resource"
        },
        "datapeek.maxArtifactMiB": {
          "type": "number",
          "default": 32,
          "minimum": 1,
          "maximum": 256,
          "scope": "resource"
        },
        "datapeek.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Cache built-in previews and opt-in custom array previews on the extension host."
        },
        "datapeek.cache.maxEntries": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 10000
        },
        "datapeek.cache.maxMiB": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "maximum": 16384
        },
        "datapeek.cache.maxAgeDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 365
        },
        "datapeek.readerPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/.datapeek/readers"
          ],
          "scope": "resource",
          "description": "Personal Python reader/renderer directories on the extension host. Project .datapeek is also searched."
        },
        "datapeek.autoPreviewPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.npy",
            "*.npz",
            "*.h5",
            "*.hdf5"
          ],
          "description": "File patterns for the temporary automatic preview mode. Add your custom formats here."
        },
        "datapeek.previewExcludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute container paths excluded from the Explorer preview menu."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "datapeek.autoPreview",
        "displayName": "DataPeek",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "npm run compile && vsce package --allow-missing-repository --no-rewrite-relative-links",
    "test:extension": "npm run compile && node --test tests/extension/*.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.0.0",
    "minimatch": "10.2.6",
    "typescript": "^5.7.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
